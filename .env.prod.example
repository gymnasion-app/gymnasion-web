# Variáveis da stack do front em produção (cole no Portainer em Environment variables > Advanced mode,
# ou copie para .env se for subir pela linha de comando). Nenhuma delas é segredo.

# Tag da imagem no GHCR (latest ou sha-xxxxxxx; uma sha fixa permite rollback)
IMAGE_TAG=latest

# Domínio público do front (DNS na Cloudflare apontando para a VPS). A API fica em https://APP_DOMAIN/api
APP_DOMAIN=gymnasion.com.br
# Certresolver do Traefik: letsencrypt (DNS na Cloudflare) ou letsencrypt-http
TRAEFIK_CERTRESOLVER=letsencrypt

# Endereço do back-end na rede "web" (nome do container da API)
API_UPSTREAM=http://gymnasion_app:8080

# Limites de recursos
WEB_CPUS=0.25
WEB_MEM_LIMIT=64m

# reCAPTCHA v2: a chave PÚBLICA (site key) é embutida na imagem durante o build no GitHub Actions.
# Cadastre-a em Settings > Secrets and variables > Actions > Variables como VITE_RECAPTCHA_SITE_KEY.
# A chave secreta fica só no back-end (RECAPTCHA_SECRET).

# No back-end (stack "gymnasion"), use o mesmo domínio:
#   FRONTEND_URL=https://gymnasion.com.br
#   STRAVA_REDIRECT_URI=https://gymnasion.com.br/strava/callback
